# Copy this file to safereport/.env and fill it in. NEVER commit .env or paste its values into chat.

# --- Google Gemini (Recommended: Best-in-class spatial grounding & 2D bounding boxes)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Amazon Bedrock (AWS Workshop Studio sandbox). Copy the three values from the event page:
#     "Get AWS CLI credentials". They expire after a few hours, so refresh them when calls start failing.
LLM_ENGINE=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# A Bedrock model id (or inference profile id) that is enabled in the sandbox and accepts images.
# Find it with:  aws bedrock list-inference-profiles   (or the Bedrock console, "Model access")
SAFEREPORT_MODEL=

# --- Alternative: Anthropic API directly (leave LLM_ENGINE unset)
# ANTHROPIC_API_KEY=

# --- ElevenLabs: the assistant's spoken questions. Without a key the browser's own voice is used.
# ELEVENLABS_VOICE_ID is optional (default: the first voice in the account).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
